<Window x:Class="RemoteInputTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スマホ用リモート入力ツール" Height="450" Width="600" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <TabControl>
        <TabItem Header="メイン">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="アクセスURL:" FontWeight="Bold" Grid.Row="0"/>
                <TextBox x:Name="UrlTextBox" IsReadOnly="True" Margin="0,0,0,10" FontSize="16" Grid.Row="1"/>
                
                <TextBlock Text="キャプチャ領域設定:" FontWeight="Bold" Grid.Row="2"/>
                <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,5">
                    <TextBlock Text="領域名:" VerticalAlignment="Center"/>
                    <TextBox x:Name="AreaNameTextBox" Width="150" Margin="5,0"/>
                    <Button Content="新規ドラッグ追加" Click="AddArea_Click" Padding="5,0"/>
                    <Button Content="選択を上書き" Click="OverwriteArea_Click" Margin="5,0" Padding="5,0"/>
                    <Button Content="削除" Click="DeleteArea_Click" Padding="5,0"/>
                </StackPanel>
                
                <ListBox x:Name="AreaListBox" DisplayMemberPath="Name" Grid.Row="4" Margin="0,0,0,10" SelectionChanged="AreaListBox_SelectionChanged"/>
                
                <TextBlock x:Name="StatusTextBlock" Foreground="Green" FontWeight="Bold" Grid.Row="5"/>
            </Grid>
        </TabItem>
        <TabItem Header="アプリ設定">
            <ScrollViewer>
                <ItemsControl x:Name="AppItemsControl" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="{Binding Id}" Width="20" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Name}" Width="150" Margin="5,0"/>
                                <TextBox Text="{Binding Path}" Width="250" Margin="5,0"/>
                                <Button Content="保存" Click="SaveApp_Click" Width="50" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
