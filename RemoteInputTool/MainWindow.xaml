<Window x:Class="RemoteInputTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スマホ用リモート入力ツール" Height="450" Width="600" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <TabControl>
        <TabItem Header="メイン">
            <StackPanel Margin="10">
                <TextBlock Text="アクセスURL:" FontWeight="Bold"/>
                <TextBox x:Name="UrlTextBox" IsReadOnly="True" Margin="0,0,0,10" FontSize="16"/>
                <TextBlock Text="キャプチャ領域名:" />
                <TextBox x:Name="AreaNameTextBox" Margin="0,0,0,10"/>
                <Button Content="ドラッグ選択" Click="DragSelect_Click" Padding="5" Margin="0,0,0,5"/>
                <Button Content="全画面選択" Click="FullScreen_Click" Padding="5" Margin="0,0,0,10"/>
                <TextBlock x:Name="StatusTextBlock" Foreground="Green" FontWeight="Bold"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="アプリ設定">
            <ScrollViewer>
                <ItemsControl x:Name="AppItemsControl" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="{Binding Id}" Width="20" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Name}" Width="150" Margin="5,0"/>
                                <TextBox Text="{Binding Path}" Width="250" Margin="5,0"/>
                                <Button Content="保存" Click="SaveApp_Click" Width="50" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
